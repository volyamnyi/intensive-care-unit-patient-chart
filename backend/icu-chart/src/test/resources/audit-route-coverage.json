{
  "version": 1,
  "note": "F8 coverage gate (issue #338): every mutating /api route maps to its canonical Audit v2 action(s), or carries an approved exclusion with a reason. Paths use Spring template form. Read-only GET routes are out of scope here — significant reads are pinned by the action registry instead.",
  "routes": [
    { "method": "POST", "path": "/api/auth/login", "actions": ["platform.auth.session.login"] },
    { "method": "POST", "path": "/api/auth/logout", "actions": ["platform.auth.session.logout"] },
    { "method": "PUT", "path": "/api/admin/users/{id}/role", "actions": ["platform.user.role.change"] },
    { "method": "DELETE", "path": "/api/admin/users/{id}", "actions": ["platform.user.disable"] },
    { "method": "PUT", "path": "/api/admin/permissions", "actions": ["platform.rbac.permission.grant", "platform.rbac.permission.revoke"] },
    { "method": "POST", "path": "/api/admin/audit/backfill", "excluded": "Migration/ops endpoint without a catalog code; the run is recorded as a legacy AuditBackfill/BACKFILL row plus the returned counts/checksum report." },
    { "method": "POST", "path": "/api/admin/audit/retention/run", "excluded": "Migration/ops endpoint without a catalog code; the run is recorded as a legacy AuditRetention/RETENTION_RUN row plus the returned archive report." },
    { "method": "POST", "path": "/api/episodes", "actions": ["icu.episode.create"] },
    { "method": "PATCH", "path": "/api/episodes/{id}", "actions": ["icu.episode.update"] },
    { "method": "POST", "path": "/api/episodes/{id}/close", "actions": ["icu.episode.close"] },
    { "method": "PUT", "path": "/api/episodes/{id}/archive", "actions": ["icu.episode.archive"] },
    { "method": "POST", "path": "/api/clinical-days", "actions": ["icu.clinical_day.create"] },
    { "method": "PATCH", "path": "/api/clinical-days/{id}", "actions": ["icu.clinical_day.update"] },
    { "method": "POST", "path": "/api/clinical-days/{id}/sign/nurse", "actions": ["icu.clinical_day.sign.nurse"] },
    { "method": "POST", "path": "/api/clinical-days/{id}/sign/doctor", "actions": ["icu.clinical_day.sign.doctor"] },
    { "method": "POST", "path": "/api/clinical-days/{id}/reopen", "actions": ["icu.clinical_day.reopen"] },
    { "method": "POST", "path": "/api/clinical-days/{id}/close-early", "actions": ["icu.clinical_day.close.early"] },
    { "method": "POST", "path": "/api/clinical-days/{clinicalDayId}/hourly-records", "actions": ["icu.hourly_record.create", "icu.hourly_record.backdate"] },
    { "method": "PATCH", "path": "/api/hourly-records/{id}", "actions": ["icu.hourly_record.update"] },
    { "method": "POST", "path": "/api/clinical-days/{clinicalDayId}/orders", "actions": ["icu.medical_order.create"] },
    { "method": "PATCH", "path": "/api/orders/{id}", "actions": ["icu.medical_order.update"] },
    { "method": "POST", "path": "/api/orders/{id}/cancel", "actions": ["icu.medical_order.cancel"] },
    { "method": "PUT", "path": "/api/orders/{orderId}/plan", "actions": ["icu.order_execution.plan"] },
    { "method": "PUT", "path": "/api/orders/{orderId}/plan/finish", "actions": ["icu.order_execution.plan.finish"] },
    { "method": "PUT", "path": "/api/orders/{orderId}/cancel", "actions": ["icu.order_execution.cancel"] },
    { "method": "POST", "path": "/api/orders/{orderId}/execute", "actions": ["icu.order_execution.execute"] },
    { "method": "POST", "path": "/api/orders/{orderId}/execute/finish", "actions": ["icu.order_execution.execute.finish"] },
    { "method": "PATCH", "path": "/api/executions/{id}", "actions": ["icu.order_execution.correct"] },
    { "method": "POST", "path": "/api/clinical-days/{clinicalDayId}/notes", "actions": ["icu.medical_note.create"] },
    { "method": "PATCH", "path": "/api/notes/{id}", "actions": ["icu.medical_note.update"] },
    { "method": "POST", "path": "/api/clinical-days/{clinicalDayId}/scales", "actions": ["icu.scale.create"] },
    { "method": "POST", "path": "/api/episodes/{episodeId}/scales", "actions": ["icu.scale.create"] },
    { "method": "POST", "path": "/api/episodes/{episodeId}/scales/calculate", "actions": ["icu.scale.calculate"] },
    { "method": "PATCH", "path": "/api/scales/{id}", "actions": ["icu.scale.update"] },
    { "method": "POST", "path": "/api/clinical-days/{clinicalDayId}/lab-results", "actions": ["icu.lab_result.create"] },
    { "method": "PATCH", "path": "/api/lab-results/{id}", "actions": ["icu.lab_result.update"] },
    { "method": "POST", "path": "/api/clinical-days/{clinicalDayId}/ventilation", "actions": ["icu.ventilation.create"] },
    { "method": "PATCH", "path": "/api/ventilation/{id}", "actions": ["icu.ventilation.update"] },
