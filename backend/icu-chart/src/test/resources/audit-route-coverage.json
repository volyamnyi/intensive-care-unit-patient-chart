    { "method": "PATCH", "path": "/api/patient-state/{id}", "actions": ["icu.patient_state.update"] },
    { "method": "POST", "path": "/api/clinical-days/{clinicalDayId}/fluid-balance/recalculate", "actions": ["icu.fluid_balance.recalculate"] },
    { "method": "POST", "path": "/api/clinical-days/{clinicalDayId}/pdf", "actions": ["icu.pdf.generate"] },
    { "method": "POST", "path": "/api/prescriptions", "actions": ["medication.list.create"] },
    { "method": "DELETE", "path": "/api/prescriptions/{id}", "actions": ["medication.list.delete"] },
    { "method": "POST", "path": "/api/prescriptions/{id}/close", "actions": ["medication.list.close"] },
    { "method": "POST", "path": "/api/prescriptions/{listId}/items", "actions": ["medication.item.add"] },
    { "method": "DELETE", "path": "/api/prescriptions/items/{itemId}", "actions": ["medication.item.remove"] },
    { "method": "POST", "path": "/api/prescriptions/items/{itemId}/days", "actions": ["medication.item.day.add"] },
    { "method": "DELETE", "path": "/api/prescriptions/items/{itemId}/days/{dayId}", "actions": ["medication.item.day.remove"] },
    { "method": "PUT", "path": "/api/prescriptions/day-parts/{dayPartId}/plan", "actions": ["medication.dose.plan"] },
    { "method": "PUT", "path": "/api/prescriptions/day-parts/{dayPartId}/complete", "actions": ["medication.dose.complete"] },
    { "method": "PUT", "path": "/api/prescriptions/day-parts/{dayPartId}/cancel", "actions": ["medication.dose.cancel"] },
    { "method": "PUT", "path": "/api/prescriptions/day-parts/{dayPartId}/replan", "actions": ["medication.dose.replan"] },
    { "method": "PUT", "path": "/api/prescriptions/day-parts/{dayPartId}/cancel-assignment", "actions": ["medication.dose.unassign"] },
    { "method": "POST", "path": "/api/prescriptions/day-parts/{dayPartId}/execute", "actions": ["medication.dose.execute"] },
    { "method": "POST", "path": "/api/vital-signs", "actions": ["medication.vitals.entry.create"] },
    { "method": "PUT", "path": "/api/vital-signs/entries/{entryId}", "actions": ["medication.vitals.entry.update"] },
    { "method": "PUT", "path": "/api/vital-signs/cells", "actions": ["medication.vitals.entry.update"] },
    { "method": "POST", "path": "/api/admin/drug-interactions/import", "actions": ["medication.interactions.import"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/templates", "actions": ["prosthetics.template.create.version"] },
    { "method": "PATCH", "path": "/api/prosthesis-manufacturing/templates/{id}", "actions": ["prosthetics.template.update"] },
    { "method": "DELETE", "path": "/api/prosthesis-manufacturing/templates/{id}", "actions": ["prosthetics.template.archive"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/orders/provision", "actions": ["prosthetics.order.provision"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/instances", "actions": ["prosthetics.instance.create"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/instances/{id}/start", "actions": ["prosthetics.instance.start"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/instances/{id}/steps/{executionId}/complete", "actions": ["prosthetics.step.complete", "prosthetics.resource.record"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/instances/{id}/backward", "actions": ["prosthetics.instance.backward"] },
    { "method": "PATCH", "path": "/api/prosthesis-manufacturing/instances/{id}/step-executions/{executionId}", "actions": ["prosthetics.step.note.update"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/instances/{id}/pause", "actions": ["prosthetics.instance.pause"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/instances/{id}/resume", "actions": ["prosthetics.instance.resume"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/instances/{id}/fail", "actions": ["prosthetics.instance.fail"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/instances/{id}/evidence", "actions": ["prosthetics.evidence.upload"] },
    { "method": "DELETE", "path": "/api/prosthesis-manufacturing/instances/{id}/evidence/{fileId}", "actions": ["prosthetics.evidence.delete"] },
    { "method": "POST", "path": "/api/prosthesis-manufacturing/instances/{id}/brak", "actions": ["prosthetics.brak.confirm", "prosthetics.brak.branch", "prosthetics.notification.queue"] },
    { "method": "PUT", "path": "/api/prosthesis-manufacturing/production/settings/normative", "actions": ["prosthetics.production.normative.update"] }
  ]
}
