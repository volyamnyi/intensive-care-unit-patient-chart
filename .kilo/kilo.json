{
  "$schema": "https://app.kilo.ai/config.json",
  "shell": "powershell",
  "logLevel": "INFO",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://192.168.24.49:11434/v1"
      },
      "models": {
        "gemma4:31b": {
          "name": "Gemma4 32k"
        },
        "gemma4:31b-64k": {
          "name": "Gemma4 64k"
        },
        "gemma4:31b-128k": {
          "name": "Gemma4 128k"
        },
        "qwen3-coder-next:Q4_K_M": {
          "name": "Qwen3 Coder Superhumans"
        },
        "hf.co/yuxinlu1/lgemma-4-12B-coder-fable5-composer2.5-v1-GGUF:Q4_K_M": {
          "name": "Lgemma 4 Coder"
        }
      }
    }
  },
  "mcp": {
    "ruflo": {
      "type": "local",
      "command": [
        "npx",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@jpisnice/shadcn-ui-mcp-server"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\projects\\kilo\\intensive-care-unit-patient-chart"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-searxng"
      ],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_READ_ONLY",
        "ghcr.io/github/github-mcp-server@sha256:2afb26356481d1a350e14544a6e160f7f7ec1561a1ea309b823665abf0309036",
        "stdio"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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",
        "GITHUB_READ_ONLY": "1"
      }
    }
  }
}
